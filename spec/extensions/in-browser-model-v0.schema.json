{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentpkg.local/spec/extensions/in-browser-model-v0.schema.json",
  "title": "agentpkg-in-browser-model-v0",
  "description": "One model the Agent Browser can run itself, inside the browser, on the machine's GPU (docs/design/in-browser-inference.md §5, D-442): the files by URL, size and SHA-256 in load order, the weights digest over the sorted file digests (D-447), the format and engine, the context, the capabilities, the licence, the source repository, whether a signed list curates it, and the GGUF header facts the GPU-memory estimate needs (or null before they are read). The weights are data the engine reads; nothing here is code. This schema checks the shape; the runtime also checks that weights_digest and bytes_total are the ones the files give, that context.default <= context.max <= min(context.train, 65536), and that file names are unique.",
  "type": "object",
  "properties": {
    "schema": {
      "const": "agentpkg-in-browser-model-v0"
    },
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9._-]{1,63}$"
    },
    "display_name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 128,
      "$ref": "#/$defs/unbroken"
    },
    "family": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64,
      "$ref": "#/$defs/unbroken"
    },
    "parameters": {
      "oneOf": [
        {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        {
          "type": "null"
        }
      ]
    },
    "format": {
      "enum": [
        "gguf"
      ]
    },
    "engine": {
      "enum": [
        "wllama"
      ]
    },
    "quantization": {
      "type": "string",
      "minLength": 1,
      "maxLength": 32,
      "$ref": "#/$defs/unbroken"
    },
    "files": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 256,
            "$ref": "#/$defs/unbroken"
          },
          "url": {
            "type": "string",
            "minLength": 9,
            "maxLength": 2048,
            "pattern": "^https://",
            "$ref": "#/$defs/unbroken"
          },
          "bytes": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9007199254740991
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        },
        "required": [
          "name",
          "url",
          "bytes",
          "sha256"
        ],
        "additionalProperties": false
      }
    },
    "weights_digest": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "bytes_total": {
      "type": "integer",
      "minimum": 1,
      "maximum": 9007199254740991
    },
    "context": {
      "type": "object",
      "properties": {
        "train": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "default": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "max": {
          "type": "integer",
          "minimum": 1,
          "maximum": 65536
        }
      },
      "required": [
        "train",
        "default",
        "max"
      ],
      "additionalProperties": false
    },
    "capabilities": {
      "type": "object",
      "properties": {
        "structured_output": {
          "type": "boolean"
        },
        "reasoning": {
          "type": [
            "boolean",
            "null"
          ]
        },
        "tool_use": {
          "type": [
            "boolean",
            "null"
          ]
        }
      },
      "required": [
        "structured_output",
        "reasoning"
      ],
      "additionalProperties": false
    },
    "license": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "$ref": "#/$defs/unbroken"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "$ref": "#/$defs/unbroken"
        },
        "url": {
          "type": "string",
          "minLength": 9,
          "maxLength": 2048,
          "pattern": "^https://",
          "$ref": "#/$defs/unbroken"
        }
      },
      "required": [
        "id",
        "name",
        "url"
      ],
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "properties": {
        "repository": {
          "type": "string",
          "minLength": 1,
          "maxLength": 256,
          "$ref": "#/$defs/unbroken"
        },
        "revision": {
          "type": "string",
          "minLength": 1,
          "maxLength": 128,
          "$ref": "#/$defs/unbroken"
        },
        "api": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 9,
              "maxLength": 2048,
              "pattern": "^https://",
              "$ref": "#/$defs/unbroken"
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "repository",
        "revision"
      ],
      "additionalProperties": false
    },
    "curated": {
      "type": "boolean"
    },
    "header": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "object",
          "properties": {
            "n_layer": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "n_kv_heads": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "key_length": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "value_length": {
              "type": "integer",
              "minimum": 1,
              "maximum": 9007199254740991
            },
            "width_basis": {
              "const": "embedding"
            }
          },
          "required": [
            "n_layer",
            "n_kv_heads",
            "key_length",
            "value_length"
          ],
          "additionalProperties": false
        }
      ]
    },
    "notes": {
      "oneOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "maxLength": 4096
        }
      ]
    }
  },
  "required": [
    "schema",
    "id",
    "display_name",
    "family",
    "format",
    "engine",
    "quantization",
    "files",
    "weights_digest",
    "bytes_total",
    "context",
    "capabilities",
    "license",
    "source",
    "curated"
  ],
  "additionalProperties": false,
  "$defs": {
    "unbroken": {
      "not": {
        "pattern": "[\\u0000-\\u001F\\u007F-\\u009F\\u2028\\u2029]"
      }
    }
  }
}
