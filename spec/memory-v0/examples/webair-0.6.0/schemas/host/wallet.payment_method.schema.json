{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Payment method",
  "type": "object",
  "properties": {
    "payment_method_id": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9-]{5,63}$"
    },
    "display": {
      "type": "string",
      "minLength": 1,
      "maxLength": 64
    }
  },
  "required": [
    "payment_method_id",
    "display"
  ],
  "additionalProperties": false
}
