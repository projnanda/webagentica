{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "reply": {
      "type": "string"
    },
    "answers": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "query": {
            "type": "string"
          },
          "answer": {
            "type": "string"
          }
        },
        "required": [
          "query",
          "answer"
        ],
        "additionalProperties": false
      },
      "maxItems": 64
    },
    "draft": {
      "type": [
        "string",
        "null"
      ]
    }
  },
  "required": [
    "reply",
    "answers",
    "draft"
  ],
  "additionalProperties": false
}
