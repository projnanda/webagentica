{
  "schema": "webagents-enforcement-cases-v0",
  "family": "network",
  "title": "network.v0 enforcement cases: what both runtimes must refuse, at which stage, with which code (spec/network-v0.md section 7)",
  "probe": "agentpkg/tests/network_probe.py",
  "stages": {
    "validation": "refused when the package is validated; the message starts with the code",
    "grants": "refused by the execution host's grant check (the once rule), with the code",
    "host": "refused by the execution host's capability check, with the code",
    "run": "the run fails with the code at the node named (or the control completes)"
  },
  "cases": [
    {"id": "no-node", "title": "A network declared and no node of type network", "stage": "validation", "code": "network_node_required", "variant": "no-node"},
    {"id": "two-nodes", "title": "Two nodes of type network", "stage": "validation", "code": "network_node_once", "variant": "two-nodes"},
    {"id": "node-on-worker", "title": "The network node on a worker instead of the coordinator", "stage": "validation", "code": "network_node_role", "variant": "node-on-worker"},
    {"id": "worker-shared", "title": "A top-level node on a worker that is a network role", "stage": "validation", "code": "network_worker_shared", "variant": "worker-shared"},
    {"id": "without-declaration", "title": "A network node in a graph that declares no network", "stage": "validation", "code": "network_without_declaration", "variant": "without-declaration"},
    {"id": "minimum-version", "title": "A network under runtime.minimum_version 0.6.0", "stage": "validation", "code": "network_minimum_version", "variant": "minimum-version"},
    {"id": "entry-unknown", "title": "An entry that is not a role", "stage": "validation", "code": "network_entry_unknown", "variant": "entry-unknown"},
    {"id": "role-unknown", "title": "A role that is not a declared worker", "stage": "validation", "code": "network_role_unknown", "variant": "role-unknown"},
    {"id": "role-coordinator", "title": "The coordinator declared as a role", "stage": "validation", "code": "network_role_coordinator", "variant": "role-coordinator"},
    {"id": "role-reserved", "title": "A role named done", "stage": "validation", "code": "network_role_reserved", "variant": "role-reserved"},
    {"id": "edge-unknown", "title": "An edge to an undeclared role", "stage": "validation", "code": "network_edge_unknown", "variant": "edge-unknown"},
    {"id": "edge-duplicate", "title": "Two edges from one role to the same target", "stage": "validation", "code": "network_edge_duplicate", "variant": "edge-duplicate"},
    {"id": "dead-end", "title": "A role with no edge that may not end", "stage": "validation", "code": "network_role_dead_end", "variant": "dead-end"},
    {"id": "state-schema-undeclared", "title": "A state schema the manifest does not declare", "stage": "validation", "code": "network_state_schema_undeclared", "variant": "state-schema-undeclared"},
    {"id": "state-schema-open", "title": "An open state schema", "stage": "validation", "code": "network_state_schema_open", "variant": "state-schema-open"},
    {"id": "state-key-undeclared", "title": "A role's view names a key the state schema lacks", "stage": "validation", "code": "network_state_key_undeclared", "variant": "state-key-undeclared"},
    {"id": "initial-not-literal", "title": "An initial state that is not a literal", "stage": "validation", "code": "network_initial_literal", "variant": "initial-not-literal"},
    {"id": "initial-invalid", "title": "An initial state the schema refuses", "stage": "validation", "code": "network_initial_invalid", "variant": "initial-invalid"},
    {"id": "message-schema-undeclared", "title": "A message schema the manifest does not declare", "stage": "validation", "code": "network_message_schema_undeclared", "variant": "message-schema-undeclared"},
    {"id": "read-outside-view", "title": "A role's step reads shared state outside its view", "stage": "validation", "code": "network_state_read_outside_view", "variant": "read-outside-view"},
    {"id": "source-outside", "title": "A role's step reads a source that is not available inside a role", "stage": "validation", "code": "network_source_scope", "variant": "source-outside"},
    {"id": "write-outside-view", "title": "A role writes a key outside its state_write view", "stage": "validation", "code": "network_state_write_outside_view", "variant": "write-outside-view"},
    {"id": "step-duplicate", "title": "Two steps of one role with the same id", "stage": "validation", "code": "network_step_duplicate", "variant": "step-duplicate"},
    {"id": "route-task-unknown", "title": "A chosen route under an undeclared model task", "stage": "validation", "code": "network_route_task_unknown", "variant": "route-task-unknown"},
    {"id": "edge-undeclared", "title": "A fixed route along an edge the role does not declare", "stage": "validation", "code": "network_edge_undeclared", "variant": "edge-undeclared"},
    {"id": "end-not-allowed", "title": "A fixed route that ends from a role that may not end", "stage": "validation", "code": "network_end_not_allowed", "variant": "end-not-allowed"},
    {"id": "bound-exceeds-budget", "title": "A worst case above the package's own hard_tokens", "stage": "validation", "code": "network_bound_exceeds_budget", "variant": "bound-exceeds-budget"},
    {"id": "read-uninitialized", "title": "A role's view reads a key that network.initial does not set", "stage": "validation", "code": "network_state_read_uninitialized", "variant": "read-uninitialized"},
    {"id": "once-memory", "title": "The memory permission granted once to a network that activates roles more than once", "stage": "grants", "code": "execution_grant_unsupported", "grants": {"memory.session": "once"}},
    {"id": "once-model", "title": "The model permission granted once to a network with more than one model call", "stage": "grants", "code": "execution_grant_unsupported", "grants": {"model.reasoning": "once"}},
    {"id": "route-cap-too-large", "title": "A route's output cap above the host's per-call ceiling", "stage": "host", "code": "execution_output_cap_too_large", "variant": "route-cap-too-large", "expect": {"node": "delegate/Desk/route"}},
    {"id": "hops-exhausted", "title": "The model hands off at the hop cap", "stage": "run", "code": "model_error", "reason": "hops_exhausted", "variant": "hops-exhausted", "expect": {"node": "delegate", "route": "delegate/Desk/route", "chosen_by": "model", "activations": {"Desk": 2, "Lookup": 1}}},
    {"id": "edge-exhausted", "title": "The model takes an edge past its max_uses", "stage": "run", "code": "model_error", "reason": "edge_exhausted", "variant": "edge-exhausted", "expect": {"node": "delegate", "route": "delegate/Desk/route", "chosen_by": "model", "activations": {"Desk": 2, "Lookup": 1}}},
    {"id": "role-exhausted", "title": "The model activates a role past its max_activations", "stage": "run", "code": "model_error", "reason": "role_exhausted", "variant": "role-exhausted", "expect": {"node": "delegate", "route": "delegate/Desk/route", "chosen_by": "model", "activations": {"Desk": 2, "Lookup": 1}}},
    {"id": "target-not-in-enum", "title": "The model names a target outside the route's enum", "stage": "run", "code": "schema_validation", "variant": "target-not-in-enum", "expect": {"node": "delegate", "route_decided": 0, "tool_called": false}},
    {"id": "message-invalid", "title": "The model's handoff message is outside the message schema", "stage": "run", "code": "schema_validation", "variant": "message-invalid", "expect": {"node": "delegate", "route_decided": 0, "tool_called": false}},
    {"id": "budget-overrun-in-role", "title": "A role's own token budget cannot hold its model call", "stage": "run", "code": "budget_exhausted", "variant": "budget-overrun-in-role", "expect": {"node": "delegate", "step": "delegate/Writer/draft", "refused": "worker_token_budget"}},
    {"id": "reservation-refused", "title": "The run has less left than the network's worst case when the node starts", "stage": "run", "code": "budget_exhausted", "reason": "tokens", "variant": "reservation-refused", "expect": {"node": "delegate", "refused_before_start": true, "activations": {}}},
    {"id": "patch-outside-schema", "title": "A role's patch leaves the shared state outside its schema (a fixed route, refused before it is decided)", "stage": "run", "code": "schema_validation", "variant": "patch-outside-schema", "expect": {"node": "delegate", "activations": {"Desk": 2, "Lookup": 1, "Writer": 1}, "committed": 3, "route_decided": 3}},
    {"id": "fixed-route-exhausted", "title": "A fixed return edge past its max_uses", "stage": "run", "code": "budget_exhausted", "reason": "edge_exhausted", "variant": "fixed-route-exhausted", "expect": {"node": "delegate", "chosen_by": "package", "activations": {"Desk": 2, "Lookup": 2}}},
    {"id": "fixture-walk", "title": "Control: the fixture walk (Desk, Lookup, Desk, Writer, Desk, done) completes within the envelope", "stage": "run", "code": "completed", "expect": {"activations": {"Desk": 3, "Lookup": 1, "Writer": 1}, "hops": 4, "tool_calls": 1, "model_calls": 7, "committed": 5}},
    {"id": "two-lookups", "title": "Control: two lookups within the caps", "stage": "run", "code": "completed", "variant": "two-lookups", "expect": {"activations": {"Desk": 3, "Lookup": 2}, "hops": 4, "tool_calls": 2, "model_calls": 6, "committed": 5}},
    {"id": "end-only", "title": "Control: the entry ends at once", "stage": "run", "code": "completed", "variant": "end-only", "expect": {"activations": {"Desk": 1}, "hops": 0, "tool_calls": 0, "model_calls": 2, "committed": 1}},
    {"id": "patch-outside-schema-chosen", "title": "A role with a chosen route writes a patch outside the state schema: refused before the route is asked", "stage": "run", "code": "schema_validation", "variant": "patch-outside-schema-chosen", "expect": {"node": "delegate", "route_decided": 0, "model_calls": 1, "committed": 0, "activations": {"Desk": 1}, "tool_called": false}},
    {"id": "answer-check-refused-in-role", "title": "A role step's answer check refuses the answer: a non-conforming answer inside the role", "stage": "run", "code": "model_error", "variant": "answer-check-refused-in-role", "expect": {"node": "delegate", "step": "delegate/Writer/draft", "route_decided": 3, "committed": 3, "activations": {"Desk": 2, "Lookup": 1, "Writer": 1}}},
    {"id": "answer-check-in-role", "title": "Control: a role step's answer check passes and the walk completes", "stage": "run", "code": "completed", "variant": "answer-check-in-role", "expect": {"activations": {"Desk": 3, "Lookup": 1, "Writer": 1}, "hops": 4, "tool_calls": 1, "model_calls": 7, "committed": 5}}
  ]
}
