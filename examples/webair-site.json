      "html": "<!doctype html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>Choose a fare · WA101 · WebAir (demo)</title>\n  <link rel=\"stylesheet\" href=\"/static/webair.css\">\n  <link rel=\"agent-package\" type=\"application/vnd.webagents.agent-package\" href=\"/agent.pkg\">\n</head>\n<body>\n  <a class=\"skip\" href=\"#main\">Skip to content</a>\n  <div class=\"demo-banner\" role=\"note\">\n    <strong>Fictional demo airline.</strong> WebAir is not a real airline. Flights, prices and\n    bookings are simulated; no real reservation or payment ever occurs.\n  </div>\n  <header class=\"site-header\">\n    <div class=\"wrap\">\n      <a class=\"brand\" href=\"/\"><span class=\"brand-mark\" aria-hidden=\"true\">✈</span> WebAir</a>\n      <nav aria-label=\"Main\">\n        <a href=\"/flights\">Book a flight</a>\n      </nav>\n    </div>\n  </header>\n<nav class=\"progress wrap\" aria-label=\"Booking progress\">\n  <ol>\n    <li class=\"done\">Search</li>\n    <li class=\"done\">Flight</li>\n    <li aria-current=\"step\">Fare</li>\n    <li>Passengers</li>\n    <li>Payment</li>\n    <li>Confirmation</li>\n  </ol>\n</nav>\n  <main id=\"main\" class=\"wrap\">\n<h1>Choose your fare</h1>\n<section class=\"card\" aria-labelledby=\"flight-heading\">\n  <h2 id=\"flight-heading\">Fri 9 Oct 2026</h2>\n  <div class=\"times\">\n  <span class=\"time\">18:05</span>\n  <span class=\"code\">BOS</span>\n  <span class=\"arrow\" aria-hidden=\"true\">→</span>\n  <span class=\"time\">07:40<sup title=\"arrives 1 day(s) later\">+1</sup></span>\n  <span class=\"code\">ZRH</span>\n</div>\n<p class=\"meta\">\n  7h 35m ·\nNonstop  · WA101\n</p>\n\n  <ol class=\"segments\">\n    <li>WA101: BOS 18:05 → ZRH 07:40 (7h 35m, Airbus A330-300)</li>\n  </ol>\n</section>\n<div class=\"table-wrap\">\n<table class=\"fares\">\n  <caption>Fares for 1 passenger, per passenger, taxes included</caption>\n  <thead>\n    <tr><th scope=\"col\">Fare</th><th scope=\"col\">Checked bags</th><th scope=\"col\">Changes</th><th scope=\"col\">Refunds</th><th scope=\"col\">Price</th><th scope=\"col\"><span class=\"visually-hidden\">Select</span></th></tr>\n  </thead>\n  <tbody>\n    <tr data-fare-id=\"WA101-20261009-BASIC\">\n      <th scope=\"row\">Economy Basic</th>\n      <td>0</td>\n      <td>No</td>\n      <td>No</td>\n      <td><strong>$704</strong></td>\n      <td>\n        <a class=\"button\" href=\"/fare/WA101-20261009-BASIC?passengers=1\" aria-label=\"Select Economy Basic\">Select</a>\n      </td>\n    </tr>\n    <tr data-fare-id=\"WA101-20261009-STANDARD\">\n      <th scope=\"row\">Economy Standard</th>\n      <td>1</td>\n      <td>Yes</td>\n      <td>No</td>\n      <td><strong>$858</strong></td>\n      <td>\n        <a class=\"button\" href=\"/fare/WA101-20261009-STANDARD?passengers=1\" aria-label=\"Select Economy Standard\">Select</a>\n      </td>\n    </tr>\n    <tr data-fare-id=\"WA101-20261009-FLEX\">\n      <th scope=\"row\">Economy Flex</th>\n      <td>2</td>\n      <td>Yes</td>\n      <td>Yes</td>\n      <td><strong>$1,201</strong></td>\n      <td>\n        <a class=\"button\" href=\"/fare/WA101-20261009-FLEX?passengers=1\" aria-label=\"Select Economy Flex\">Select</a>\n      </td>\n    </tr>\n    <tr data-fare-id=\"WA101-20261009-BUSINESS\">\n      <th scope=\"row\">Business</th>\n      <td>2</td>\n      <td>Yes</td>\n      <td>Yes</td>\n      <td><strong>$3,432</strong></td>\n      <td>\n        <a class=\"button\" href=\"/fare/WA101-20261009-BUSINESS?passengers=1\" aria-label=\"Select Business\">Select</a>\n      </td>\n    </tr>\n  </tbody>\n</table>\n</div>\n  </main>\n  <footer class=\"site-footer\">\n    <div class=\"wrap\">\n      <p>WebAir is a fictional airline built for the WebAgents research demo. All schedules\n         and fares are invented. No real transaction is ever performed.</p>\n      <p>This origin advertises an experimental agent-native interface in its page metadata\n         (<code>rel=\"agent-package\"</code>, a WebAgents demo convention).</p>\n    </div>\n  </footer>\n</body>\n</html>"
