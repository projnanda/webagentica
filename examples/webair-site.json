      "html": "<!doctype html>\n<html lang=\"en\">\n<head>\n  <meta charset=\"utf-8\">\n  <meta name=\"viewport\" content=\"width=device-width, initial-scale=1\">\n  <title>Fly WebAir · WebAir (demo)</title>\n  <link rel=\"stylesheet\" href=\"/static/webair.css\">\n  <link rel=\"agent-package\" type=\"application/vnd.webagents.agent-package\" href=\"/agent.pkg\">\n</head>\n<body>\n  <a class=\"skip\" href=\"#main\">Skip to content</a>\n  <div class=\"demo-banner\" role=\"note\">\n    <strong>Fictional demo airline.</strong> WebAir is not a real airline. Flights, prices and\n    bookings are simulated; no real reservation or payment ever occurs.\n  </div>\n  <header class=\"site-header\">\n    <div class=\"wrap\">\n      <a class=\"brand\" href=\"/\"><span class=\"brand-mark\" aria-hidden=\"true\">✈</span> WebAir</a>\n      <nav aria-label=\"Main\">\n        <a href=\"/flights\">Book a flight</a>\n      </nav>\n    </div>\n  </header>\n  <main id=\"main\" class=\"wrap\">\n<section class=\"hero\">\n  <h1>Fly between Boston, New York and Europe</h1>\n  <p>Nonstop service to Zurich and Geneva, with connections through London and Reykjavik.</p>\n  <form class=\"card search\" action=\"/results\" method=\"get\" aria-labelledby=\"search-heading\">\n    <h2 id=\"search-heading\">Search flights</h2>\n    <div class=\"grid\"><div class=\"field\"><label for=\"origin\">From</label>\n<select id=\"origin\" name=\"origin\" required>\n  <option value=\"BOS\" selected>Boston (BOS)</option>\n  <option value=\"JFK\">New York (JFK)</option>\n  <option value=\"ZRH\">Zurich (ZRH)</option>\n  <option value=\"GVA\">Geneva (GVA)</option>\n  <option value=\"LHR\">London (LHR)</option>\n  <option value=\"KEF\">Reykjavik (KEF)</option>\n</select>\n</div>\n<div class=\"field\"><label for=\"destination\">To</label>\n<select id=\"destination\" name=\"destination\" required>\n  <option value=\"BOS\">Boston (BOS)</option>\n  <option value=\"JFK\">New York (JFK)</option>\n  <option value=\"ZRH\" selected>Zurich (ZRH)</option>\n  <option value=\"GVA\">Geneva (GVA)</option>\n  <option value=\"LHR\">London (LHR)</option>\n  <option value=\"KEF\">Reykjavik (KEF)</option>\n</select>\n</div>\n<div class=\"field\">\n  <label for=\"date\">Departure date</label>\n  <input id=\"date\" name=\"date\" type=\"date\" required min=\"2026-10-01\" max=\"2027-12-31\"\n         value=\"2026-10-09\">\n</div>\n<div class=\"field\">\n  <label for=\"passengers\">Passengers</label>\n  <select id=\"passengers\" name=\"passengers\">\n    <option value=\"1\" selected>1</option>\n    <option value=\"2\">2</option>\n    <option value=\"3\">3</option>\n    <option value=\"4\">4</option>\n    <option value=\"5\">5</option>\n    <option value=\"6\">6</option>\n  </select>\n</div>\n</div>\n    <div class=\"actions\">\n      <button type=\"submit\">Search flights</button>\n      <a href=\"/flights\">More search options</a>\n    </div>\n  </form>\n</section>\n<section aria-labelledby=\"routes-heading\">\n  <h2 id=\"routes-heading\">Popular routes</h2>\n  <ul class=\"routes\">\n    <li><a href=\"/results?origin=BOS&amp;destination=ZRH&amp;date=2026-10-09&amp;passengers=1\">Boston → Zurich</a></li>\n    <li><a href=\"/results?origin=ZRH&amp;destination=BOS&amp;date=2026-10-09&amp;passengers=1\">Zurich → Boston</a></li>\n    <li><a href=\"/results?origin=JFK&amp;destination=ZRH&amp;date=2026-10-09&amp;passengers=1\">New York → Zurich</a></li>\n    <li><a href=\"/results?origin=BOS&amp;destination=LHR&amp;date=2026-10-09&amp;passengers=1\">Boston → London</a></li>\n  </ul>\n  <p class=\"note\">The demo schedule runs from Thu 1 Oct 2026 to Fri 31 Dec 2027.</p>\n</section>\n  </main>\n  <footer class=\"site-footer\">\n    <div class=\"wrap\">\n      <p>WebAir is a fictional airline built for the WebAgents research demo. All schedules\n         and fares are invented. No real transaction is ever performed.</p>\n      <p>This origin advertises an experimental agent-native interface in its page metadata\n         (<code>rel=\"agent-package\"</code>, a WebAgents demo convention).</p>\n    </div>\n  </footer>\n</body>\n</html>"
