      "$ref": "input.schema.json"
    },
    "totals": {
      "anyOf": [
        {
          "$ref": "fare-output.schema.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "ids": {
      "anyOf": [
        {
          "$ref": "assign-output.schema.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "quotes": {
