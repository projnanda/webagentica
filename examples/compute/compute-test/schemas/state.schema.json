        {
          "$ref": "fare-outputs.schema.json"
        },
        {
          "type": "null"
        }
      ]
    },
    "checked": {
      "anyOf": [
        {
          "$ref": "check.schema.json"
        },
        {
          "type": "null"
        }
      ]
