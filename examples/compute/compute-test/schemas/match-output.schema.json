{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "matches": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "quote": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"
          },
          "source": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"
          },
          "offset": {
            "type": "integer",
            "minimum": 0
          }
        },
        "required": [
          "quote",
          "source",
          "offset"
        ],
        "additionalProperties": false
      }
    },
    "unmatched": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"
      }
    }
  },
  "required": [
    "matches",
    "unmatched"
  ],
  "additionalProperties": false
}
