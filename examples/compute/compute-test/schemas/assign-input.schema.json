{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "records": {
      "type": "array",
      "minItems": 1,
      "maxItems": 512,
      "items": {
        "type": "object",
        "properties": {
          "doi": {
            "type": "string",
            "maxLength": 200
          },
          "arxiv": {
            "type": "string",
            "maxLength": 100
          },
          "url": {
            "type": "string",
            "maxLength": 2048
          },
          "title": {
            "type": "string",
            "maxLength": 500
          }
        },
        "additionalProperties": false
      }
    }
  },
  "required": [
    "records"
  ],
  "additionalProperties": false
}
