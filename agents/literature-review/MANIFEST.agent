{
  "spec_version": "0.1",
  "package_id": "org.webagents.literature-review",
  "name": "Literature Review Agent",
  "version": "0.2.9",
  "description": "A constrained coordinator-worker review with structured evidence and verified citations; with the person's leave it reads their research profile, keeps its own notes and proposes to remember the review; its candidate deduplication runs as a WebAssembly module that can only compute. Bundled demo data are synthetic.",
  "publisher": {
    "id": "webagents-research",
    "name": "WebAgents Research Prototype"
  },
