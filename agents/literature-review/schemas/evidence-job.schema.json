{
  "type": "object",
  "properties": {
    "paper": {
      "$ref": "paper.schema.json"
    },
    "record": {
      "$ref": "citation-record.schema.json"
    },
    "file_id": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "type": "string",
          "pattern": "^[A-Za-z0-9][A-Za-z0-9_-]{0,127}$"
        }
      ]
    },
    "handle": {
      "type": "string",
      "pattern": "^P[1-3]$"
    },
    "evidence_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^P[1-3]:e[1-4]$"
      },
      "minItems": 4,
      "maxItems": 4
    }
  },
  "required": [
    "paper",
    "record",
    "file_id",
    "handle",
    "evidence_ids"
  ],
  "additionalProperties": false
}
