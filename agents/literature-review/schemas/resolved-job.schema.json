{
  "type": "object",
  "properties": {
    "paper": {
      "$ref": "paper.schema.json"
    },
    "response": {
      "$ref": "resolver-output.schema.json"
    },
    "handle": {
      "type": "string",
      "pattern": "^P[1-3]$"
    },
    "evidence_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^P[1-3]:e[1-4]$"
      },
      "minItems": 4,
      "maxItems": 4
    }
  },
  "required": [
    "paper",
    "response",
    "handle",
    "evidence_ids"
  ],
  "additionalProperties": false
}
