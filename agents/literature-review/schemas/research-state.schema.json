{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "research_question": {
      "type": "string"
    },
    "mode": {
      "enum": [
        "fixture",
        "live"
      ]
    },
    "reasoning_mode": {
      "enum": [
        "extractive",
        "model"
      ]
    },
    "search_plan": {
      "type": "object",
      "properties": {
        "queries": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "rationale": {
          "type": "string"
        },
        "seed_queries": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "queries",
        "rationale"
      ],
      "additionalProperties": false
    },
    "search_queries": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "citation_records": {
      "$ref": "records.schema.json"
    },
    "evidence_items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "evidence_id": {
            "type": "string"
          },
          "paper_id": {
            "type": "string"
          },
          "text": {
            "type": "string"
          },
          "quote": {
            "type": "string"
          },
          "category": {
            "enum": [
              "method",
              "finding",
              "setup",
              "limitation"
            ]
          },
          "scope": {
            "enum": [
              "abstract",
              "full_text"
            ]
          },
          "support_strength": {
            "enum": [
              "direct_quote",
              "model_interpretation"
            ]
          },
          "location": {
            "type": "object",
            "properties": {
              "page": {
                "type": [
                  "integer",
                  "null"
                ]
              },
              "section": {
                "type": "string"
              }
            },
            "required": [
              "page",
              "section"
            ],
            "additionalProperties": false
          },
          "extraction_worker": {
            "type": "string"
          },
          "provenance": {
            "type": "object",
            "properties": {
              "source": {
                "type": "string"
              },
              "locator": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "source_sha256": {
                "type": "string"
              },
              "synthetic": {
                "type": "boolean"
              }
            },
            "required": [
              "source",
              "locator",
              "source_sha256",
              "synthetic"
            ],
            "additionalProperties": false
          }
        },
        "required": [
          "evidence_id",
          "paper_id",
          "text",
          "quote",
          "category",
          "scope",
          "support_strength",
          "location",
          "extraction_worker",
          "provenance"
        ],
        "additionalProperties": false
      }
    },
    "themes": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "theme_id": {
            "type": "string"
          },
          "label": {
            "type": "string"
          },
          "evidence_ids": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "method_comparison": {
            "type": "string"
          },
          "limitations": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "inference_level": {
            "enum": [
              "extractive_grouping",
              "model_synthesis"
            ]
          }
        },
        "required": [
          "theme_id",
          "label",
          "evidence_ids",
          "method_comparison",
          "limitations",
          "inference_level"
        ],
        "additionalProperties": false
      }
    },
    "claims": {
      "type": "array",
      "items": {
        "$ref": "claim-draft.schema.json"
      }
    },
    "draft": {
      "type": "object",
      "properties": {
        "title": {
          "type": "string"
        },
        "claim_ids": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "title",
        "claim_ids"
      ],
      "additionalProperties": false
    },
    "verification_results": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "claim_id": {
            "type": "string"
          },
          "status": {
            "enum": [
              "supported",
              "unsupported",
              "overstated"
            ]
          },
          "checks": {
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "reason": {
            "type": "string"
          },
          "semantic_judgment": {
            "enum": [
              "not_needed",
              "model",
              "not_performed"
            ]
          }
        },
        "required": [
          "claim_id",
          "status",
          "checks",
          "reason",
          "semantic_judgment"
        ],
        "additionalProperties": false
      }
    },
    "unresolved": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "paper_id": {
            "type": "string"
          },
          "status": {
            "type": "string"
          },
          "message": {
            "type": "string"
          },
          "alternatives": {
            "type": "array",
            "items": {
              "type": "object"
            }
          }
        },
        "required": [
          "paper_id",
          "status",
          "message",
          "alternatives"
        ],
        "additionalProperties": false
      }
    },
    "document_refs": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    },
    "seed_references": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "anyOf": [
          {
            "type": "string",
            "maxLength": 500
          },
          {
            "type": "object"
          }
        ]
      }
    },
    "search_batches": {
      "$ref": "search-batches.schema.json"
    },
    "raw_candidates": {
      "$ref": "raw-papers.schema.json"
    },
    "citation_jobs": {
      "$ref": "paper-ids.schema.json"
    },
    "resolved_jobs": {
      "$ref": "resolved-jobs.schema.json"
    },
    "evidence_jobs": {
      "type": "array",
      "items": {
        "$ref": "evidence-job.schema.json"
      }
    },
    "evidence_batches": {
      "$ref": "evidence-batches.schema.json"
    },
    "final": {
      "anyOf": [
        {
          "type": "object",
          "properties": {},
          "required": [],
          "additionalProperties": false
        },
        {
          "$ref": "review-output.schema.json"
        }
      ]
    },
    "review": {
      "anyOf": [
        {
          "type": "object",
          "properties": {},
          "required": [],
          "additionalProperties": false
        },
        {
          "$ref": "review-draft.schema.json"
        }
      ]
    },
    "bibliography": {
      "$ref": "bibliography.schema.json"
    },
    "preparation_batches": {
      "$ref": "preparation-batches.schema.json"
    },
    "materialized_claims": {
      "$ref": "claims.schema.json"
    },
    "evidence_table": {
      "$ref": "evidence-list.schema.json"
    },
    "seed_batches": {
      "$ref": "search-batches.schema.json"
    },
    "all_batches": {
      "$ref": "search-batches.schema.json"
    },
    "identified": {
      "$ref": "identified.schema.json"
    },
    "found_papers": {
      "$ref": "papers.schema.json"
    },
    "found_refs": {
      "$ref": "candidate-refs.schema.json"
    },
    "normalize_documents": {
      "$ref": "documents.schema.json"
    },
    "candidate_refs": {
      "$ref": "candidate-refs.schema.json"
    },
    "screening_batches": {
      "$ref": "screening-batches.schema.json"
    },
    "included_papers": {
      "$ref": "papers.schema.json"
    },
    "selection": {
      "$ref": "selection.schema.json"
    },
    "papers_found": {
      "$ref": "papers-found.schema.json"
    },
    "selection_slots": {
      "$ref": "slots.schema.json"
    },
    "handle_slots": {
      "$ref": "handle-slots.schema.json"
    },
    "handle_job_batches": {
      "$ref": "handle-job-batches.schema.json"
    },
    "handle_jobs": {
      "$ref": "handle-jobs.schema.json"
    },
    "use_profile": {
      "type": "boolean"
    },
    "keep_notes": {
      "type": "boolean"
    },
    "reviewed_on": {
      "type": [
        "string",
        "null"
      ]
    },
    "research_profile": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "host/research.profile.view.schema.json#/properties/fields"
        }
      ]
    },
    "research_profile_note": {
      "type": "string"
    },
    "research_profile_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "agent_notes": {
      "type": "string"
    },
    "notes_written": {
      "anyOf": [
        {
          "type": "null"
        },
        {
          "$ref": "notes-written.schema.json"
        }
      ]
    },
    "remember": {
      "$ref": "remember.schema.json"
    },
    "remember_gate": {
      "type": "boolean"
    },
    "review_papers": {
      "$ref": "review-papers.schema.json"
    },
    "review_links": {
      "$ref": "review-links.schema.json"
    },
    "memory_proposals": {
      "$ref": "review-proposals.schema.json"
    },
    "identity_rows": {
      "$ref": "identity-rows.schema.json"
    },
    "unique_candidates": {
      "$ref": "unique-candidates.schema.json"
    }
  },
  "required": [
    "research_question",
    "mode",
    "reasoning_mode",
    "search_plan",
    "search_queries",
    "citation_records",
    "evidence_items",
    "themes",
    "claims",
    "draft",
    "verification_results",
    "unresolved",
    "use_profile",
    "keep_notes",
    "reviewed_on",
    "research_profile",
    "research_profile_note",
    "research_profile_id",
    "agent_notes",
    "notes_written",
    "remember",
    "remember_gate",
    "review_papers",
    "review_links",
    "memory_proposals"
  ],
  "additionalProperties": false
}
