{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^P[1-9][0-9]{0,3}$"
    },
    "key": {
      "type": "string",
      "pattern": "^(doi|arxiv|url|title):.+$",
      "maxLength": 2100
    },
    "doi": {
      "type": "string",
      "maxLength": 200
    },
    "arxiv": {
      "type": "string",
      "maxLength": 100
    },
    "url": {
      "type": "string",
      "maxLength": 2048
    },
    "title": {
      "type": "string",
      "maxLength": 1000
    },
    "paper": {
      "$ref": "raw-paper.schema.json"
    }
  },
  "required": [
    "id",
    "key",
    "doi",
    "arxiv",
    "url",
    "title",
    "paper"
  ],
  "additionalProperties": false
}
