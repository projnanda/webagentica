{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "A chosen paper to cite: its handle, the evidence ids its extraction may use, and the paper's own record.",
  "type": "object",
  "properties": {
    "handle": {
      "type": "string",
      "pattern": "^P[1-3]$"
    },
    "evidence_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^P[1-3]:e[1-4]$"
      },
      "minItems": 4,
      "maxItems": 4
    },
    "paper": {
      "$ref": "paper.schema.json"
    }
  },
  "required": [
    "handle",
    "evidence_ids",
    "paper"
  ],
  "additionalProperties": false
}
