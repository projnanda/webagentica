{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"
    },
    "type": {
      "const": "research.profile"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "fields": {
      "title": "Research profile",
      "type": "object",
      "properties": {
        "interests": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "minItems": 1,
          "maxItems": 16
        },
        "affiliations": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "maxItems": 8
        },
        "seed_papers": {
          "type": "array",
          "maxItems": 32,
          "items": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string",
                "minLength": 1,
                "maxLength": 500
              },
              "doi": {
                "type": "string",
                "minLength": 1,
                "maxLength": 200
              }
            },
            "additionalProperties": false
          }
        },
        "avoid": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1,
            "maxLength": 120
          },
          "maxItems": 16
        }
      },
      "required": [
        "interests"
      ],
      "additionalProperties": false
    },
    "body": {
      "type": "string",
      "maxLength": 16384
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9_/-]{0,47}$"
      },
      "maxItems": 32,
      "uniqueItems": true
    },
    "sealed": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 2,
        "maxLength": 256,
        "pattern": "^(/[^/]+)+$"
      },
      "maxItems": 16,
      "uniqueItems": true
    }
  },
  "required": [
    "id",
    "type",
    "title",
    "fields",
    "body",
    "tags",
    "sealed"
  ],
  "additionalProperties": false
}
