{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "array",
  "maxItems": 1,
  "items": {
    "type": "object",
    "properties": {
      "to": {
        "type": "string",
        "pattern": "^mem_[0-9a-f]{32}$"
      },
      "rel": {
        "const": "derived_from"
      }
    },
    "required": [
      "to",
      "rel"
    ],
    "additionalProperties": false
  }
}
