{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "doi": {
      "type": "string",
      "maxLength": 200
    },
    "arxiv": {
      "type": "string",
      "maxLength": 100
    },
    "url": {
      "type": "string",
      "maxLength": 2048
    },
    "title": {
      "type": "string",
      "maxLength": 1000
    },
    "paper": {
      "$ref": "raw-paper.schema.json"
    }
  },
  "required": [
    "doi",
    "arxiv",
    "url",
    "title",
    "paper"
  ],
  "additionalProperties": false
}
