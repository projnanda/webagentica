{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "description": "One of three citation positions: the handle the review names the paper by (P1, P2, P3), the chosen paper's id or \"\" when fewer were chosen, and the evidence ids its extraction may use.",
  "type": "object",
  "properties": {
    "handle": {
      "type": "string",
      "pattern": "^P[1-3]$"
    },
    "paper_id": {
      "type": "string"
    },
    "evidence_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^P[1-3]:e[1-4]$"
      },
      "minItems": 4,
      "maxItems": 4
    }
  },
  "required": [
    "handle",
    "paper_id",
    "evidence_ids"
  ],
  "additionalProperties": false
}
