{
  "spec_version": "0.1",
  "permissions": [
    {
      "id": "network.scholarly",
      "kind": "network",
      "description": "Read Crossref scholarly metadata for bounded search queries.",
      "required": true,
      "resources": [
        "api.crossref.org"
      ]
    },
    {
      "id": "network.citations",
      "kind": "network",
      "description": "Verify references through the existing Citation Resolver service; when it is unavailable, the browser may look a DOI up at Crossref instead.",
      "required": true,
      "resources": [
        "webagents-citation-resolver-production.up.railway.app",
        "api.crossref.org"
      ]
    },
    {
      "id": "files.pdfs",
      "kind": "files.read",
      "description": "Read only individually selected local PDF files.",
      "required": false,
      "resources": [
        "user-selected-pdfs"
      ]
    },
    {
      "id": "memory.research_profile",
      "kind": "memory.read",
      "description": "Read the research profile you choose from your memory (interests, affiliations, seed papers, topics to avoid) to focus the search and the screening. The profile is shown to the model as the person's own words.",
      "required": false,
      "resources": [
        "research.profile"
      ]
    },
    {
      "id": "model.reasoning",
      "kind": "model",
      "description": "Use the host-selected reasoning router within the token cap.",
      "required": false,
      "resources": [
        "host-router"
      ]
    },
    {
      "id": "memory.session",
      "kind": "memory",
      "description": "Read and write explicit worker state views for this session only.",
      "required": true,
      "resources": [
        "session"
      ]
    },
    {
      "id": "memory.remember",
      "kind": "memory.write",
      "description": "After a review, propose to remember it: the question, the date, the papers found and the summary. Nothing is written until you accept the proposal after the run.",
      "required": false,
      "resources": [
        "research.review"
      ]
    },
    {
      "id": "memory.agent",
      "kind": "memory",
      "description": "Keep its own notes between runs (at most 32,768 characters): what it searched and kept last time. Read at the start of a run, written once at the end; you can read and clear them in Settings → Memory.",
      "required": false,
      "resources": [
        "agent"
      ]
    },
    {
      "id": "compute.bookkeeping",
      "kind": "compute",
      "description": "Run the package's bookkeeping module (WebAssembly, no imports): exact deduplication of the found papers by normalized DOI, arXiv id, URL or title. It can only compute over the records the graph gives it.",
      "required": true,
      "resources": [
        "bookkeeping"
      ]
    }
  ],
  "network": {
    "allowed_domains": [
      "api.crossref.org",
      "webagents-citation-resolver-production.up.railway.app"
    ],
    "https_only": true,
    "allow_redirects": false
  },
  "memory": {
    "scope": "agent-scoped",
    "retention": "user-managed",
    "raw_documents": false,
    "state_schema": "schemas/research-state.schema.json",
    "sharing": "explicit_views"
  },
  "budget": {
    "estimated_tokens": 24000,
    "hard_tokens": 180000,
    "max_remote_calls": 45,
    "max_calls_per_tool": {
      "scholarly-search": 3,
      "citation-resolver": 20,
      "paper-reader": 10,
      "research.profile": 1,
      "agent-notes.read": 1,
      "agent-notes.write": 1
    },
    "max_parallel_workers": 3,
    "estimated_cost_usd": null,
    "approval_threshold_tokens": null
  },
  "delegation": {
    "max_depth": 1,
    "approved_roles": [
      "PlanningWorker",
      "SearchWorker",
      "ScreeningWorker",
      "CitationWorker",
      "EvidenceWorker",
      "SynthesisWorker",
      "WritingWorker",
      "VerificationWorker",
      "MemoryWorker",
      "RememberWorker"
    ],
    "allow_remote": false
  },
  "extensions": {}
}
