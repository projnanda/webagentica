{
  "spec_version": "0.1",
  "id": "search-flights",
  "version": "0.1.0",
  "description": "Search WebAir's fictional flights for one date: one row per flight, lowest fare.",
  "execution": "remote",
  "binding": "webair.travel_flights",
  "endpoint": "https://webagents-webair-production.up.railway.app/api/v1/travel/flights",
  "method": "POST",
  "input_schema": "schemas/flight-query.schema.json",
  "output_schema": "schemas/flight-options.schema.json",
  "permissions": [
    "network.webair"
  ],
  "domains": [
    "webagents-webair-production.up.railway.app"
  ],
  "timeout_seconds": 15,
  "retries": 0,
  "side_effects": "read",
  "approval_required": false,
  "extensions": {}
}
