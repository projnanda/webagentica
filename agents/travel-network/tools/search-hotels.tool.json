{
  "spec_version": "0.1",
  "id": "search-hotels",
  "version": "0.1.0",
  "description": "Search two fictional hotels at the destination for a stay.",
  "execution": "remote",
  "binding": "webair.travel_hotels",
  "endpoint": "https://webagents-webair-production.up.railway.app/api/v1/travel/hotels",
  "method": "POST",
  "input_schema": "schemas/hotel-query.schema.json",
  "output_schema": "schemas/hotel-options.schema.json",
  "permissions": [
    "network.webair"
  ],
  "domains": [
    "webagents-webair-production.up.railway.app"
  ],
  "timeout_seconds": 15,
  "retries": 0,
  "side_effects": "read",
  "approval_required": false,
  "extensions": {}
}
