{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "origin": {
      "type": "string"
    },
    "destination": {
      "type": "string"
    },
    "date": {
      "type": "string",
      "format": "date"
    },
    "travellers": {
      "type": "integer",
      "minimum": 1
    }
  },
  "required": [
    "origin",
    "destination",
    "date",
    "travellers"
  ],
  "additionalProperties": false
}
