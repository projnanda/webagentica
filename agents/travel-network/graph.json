          "path": "/flights"
        },
        "hotels": {
          "from": "state",
          "path": "/hotels"
        },
        "calendar": {
          "from": "state",
          "path": "/calendar"
        }
      }
    },
    "roles": {
      "FrontMan": {
        "description": "Understands the traveller's request, keeps the trip facts, and decides which specialist to consult next or ends with the plan.",
        "steps": [
          {
            "id": "understand",
            "type": "llm",
            "task": "understand",
            "max_output_tokens": 1500,
            "input": {
              "object": {
                "text": {
                  "from": "message",
                  "path": "/text"
                },
                "trip": {
                  "from": "state",
                  "path": "/trip"
                },
                "flights": {
                  "from": "state",
                  "path": "/flights"
                },
                "hotels": {
                  "from": "state",
                  "path": "/hotels"
                },
                "calendar": {
                  "from": "state",
                  "path": "/calendar"
                }
              }
            },
            "output_schema": "schemas/understanding.schema.json",
            "timeout_seconds": 90
          }
        ],
        "writes": {
          "/trip": {
            "from": "steps",
            "path": "/understand/trip"
          }
        },
        "route": {
          "task": "route",
          "max_output_tokens": 1500,
          "input": {
            "object": {
              "summary": {
                "from": "steps",
                "path": "/understand/summary"
              },
              "trip": {
                "from": "steps",
                "path": "/understand/trip"
              },
              "flights": {
                "from": "state",
                "path": "/flights"
              },
              "hotels": {
                "from": "state",
                "path": "/hotels"
              },
              "calendar": {
                "from": "state",
                "path": "/calendar"
              }
            }
