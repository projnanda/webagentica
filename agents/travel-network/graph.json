  "deadline_seconds": 900,
  "network": {
    "entry": "FrontMan",
    "max_hops": 6,
    "state_schema": "schemas/network-state.schema.json",
    "initial": {
      "literal": {
        "trip": null,
        "flights": [],
        "hotels": [],
