        },
        "timeout_seconds": 200,
        "edges": [
          {
            "to": "Flights",
            "max_uses": 1
          },
          {
            "to": "Hotel",
            "max_uses": 1
          },
          {
            "to": "Calendar",
            "max_uses": 1
          }
        ],
        "may_end": true
      },
      "Flights": {
        "description": "Searches WebAir's flights for the trip in the shared state (fictional airline data).",
        "steps": [
          {
            "id": "search",
            "type": "tool",
            "tool": "search-flights",
            "input": {
              "object": {
                "origin": {
                  "from": "state",
                  "path": "/trip/origin"
                },
                "destination": {
                  "from": "state",
                  "path": "/trip/destination"
                },
                "date": {
                  "from": "state",
                  "path": "/trip/date_out"
                },
                "travellers": {
                  "from": "state",
                  "path": "/trip/travellers"
                }
              }
            },
            "output_schema": "schemas/flight-options.schema.json",
            "timeout_seconds": 20
          }
        ],
        "writes": {
          "/flights": {
            "from": "steps",
            "path": "/search/options"
          }
        },
        "route": {
          "next": "FrontMan",
          "message": {
            "object": {
              "text": {
                "literal": "Results are in the shared state."
              }
            }
          }
        },
        "timeout_seconds": 30,
        "edges": [
          {
            "to": "FrontMan",
            "max_uses": 1
          }
        ],
        "may_end": false
      },
      "Hotel": {
        "description": "Searches hotels at the destination for the trip's nights (fictional data).",
        "steps": [
          {
            "id": "search",
            "type": "tool",
            "tool": "search-hotels",
            "input": {
              "object": {
                "city": {
                  "from": "state",
                  "path": "/trip/destination"
                },
                "check_in": {
                  "from": "state",
                  "path": "/trip/date_out"
                },
                "check_out": {
                  "from": "state",
                  "path": "/trip/date_back"
                }
              }
            },
            "output_schema": "schemas/hotel-options.schema.json",
            "timeout_seconds": 20
          }
        ],
        "writes": {
          "/hotels": {
            "from": "steps",
            "path": "/search/options"
          }
        },
        "route": {
          "next": "FrontMan",
          "message": {
            "object": {
              "text": {
                "literal": "Results are in the shared state."
              }
            }
          }
        },
        "timeout_seconds": 30,
        "edges": [
          {
            "to": "FrontMan",
            "max_uses": 1
          }
        ],
        "may_end": false
      },
      "Calendar": {
        "description": "Lists the traveller's calendar entries over the trip's dates (fictional data).",
        "steps": [
          {
            "id": "check",
            "type": "tool",
            "tool": "check-calendar",
            "input": {
              "object": {
                "from": {
                  "from": "state",
                  "path": "/trip/date_out"
                },
                "to": {
                  "from": "state",
                  "path": "/trip/date_back"
                }
              }
            },
            "output_schema": "schemas/calendar-entries.schema.json",
            "timeout_seconds": 20
          }
        ],
        "writes": {
          "/calendar": {
            "from": "steps",
            "path": "/check/entries"
          }
        },
        "route": {
          "next": "FrontMan",
          "message": {
            "object": {
              "text": {
                "literal": "Results are in the shared state."
              }
            }
          }
        },
        "timeout_seconds": 30,
        "edges": [
          {
            "to": "FrontMan",
            "max_uses": 1
          }
        ],
        "may_end": false
      }
    }
  },
  "fixture": "fixtures/workflow.json",
