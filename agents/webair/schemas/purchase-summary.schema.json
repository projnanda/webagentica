{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Simulated purchase summary",
  "description": "WebAir's demo confirmation, without the passenger identity or the payment method.",
  "anyOf": [
    {
      "type": "null"
    },
    {
      "type": "object",
      "properties": {
        "confirmation_id": {
          "type": "string",
          "pattern": "^WA-DEMO-[A-Z2-9]{5}$"
        },
        "status": {
          "const": "simulated"
        },
        "quote_id": {
          "type": "string",
          "pattern": "^WAQ-[0-9A-F]{16}$"
        },
        "fare_id": {
          "type": "string",
          "pattern": "^WA[0-9]{3}(-WA[0-9]{3})?-[0-9]{8}-(BASIC|STANDARD|FLEX|BUSINESS)$"
        },
        "fare_name": {
          "type": "string"
        },
        "flight": {
          "$ref": "api/get_fare_rules.output.schema.json#/$defs/Itinerary"
        },
        "total_usd": {
          "type": "integer"
        },
        "amount_charged_usd": {
          "const": 0
        },
        "currency": {
          "const": "USD"
        },
        "real_transaction": {
          "const": false
        },
        "simulated": {
          "const": true
        },
        "message": {
          "type": "string"
        },
        "passenger_count": {
          "const": 1
        }
      },
      "required": [
        "amount_charged_usd",
        "confirmation_id",
        "currency",
        "fare_id",
        "fare_name",
        "flight",
        "message",
        "passenger_count",
        "quote_id",
        "real_transaction",
        "simulated",
        "status",
        "total_usd"
      ],
      "additionalProperties": false
    }
  ]
}
