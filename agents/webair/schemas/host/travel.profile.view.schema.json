{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"
    },
    "type": {
      "const": "travel.profile"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "fields": {
      "title": "Travel profile",
      "type": "object",
      "properties": {
        "home_airport": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        },
        "preferred_cabin": {
          "enum": [
            "economy",
            "business"
          ]
        },
        "prefer_nonstop": {
          "type": "boolean"
        },
        "preferred_currency": {
          "type": "string",
          "pattern": "^[A-Z]{3}$"
        }
      },
      "required": [
        "home_airport",
        "preferred_cabin",
        "prefer_nonstop",
        "preferred_currency"
      ],
      "additionalProperties": false
    },
    "body": {
      "type": "string",
      "maxLength": 16384
    },
    "tags": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^[a-z0-9][a-z0-9_/-]{0,47}$"
      },
      "maxItems": 32,
      "uniqueItems": true
    },
    "sealed": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 2,
        "maxLength": 256,
        "pattern": "^(/[^/]+)+$"
      },
      "maxItems": 16,
      "uniqueItems": true
    }
  },
  "required": [
    "id",
    "type",
    "title",
    "fields",
    "body",
    "tags",
    "sealed"
  ],
  "additionalProperties": false
}
