{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "currency": {
      "type": "string",
      "pattern": "^[A-Z]{3}$"
    },
    "tax_rate_bps": {
      "type": "integer",
      "minimum": 0,
      "maximum": 10000
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "properties": {
          "label": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "amount_cents": {
            "type": "integer",
            "minimum": 0,
            "maximum": 9007199254740991
          },
          "quantity": {
            "type": "integer",
            "minimum": 1,
            "maximum": 9
          }
        },
        "required": [
          "label",
          "amount_cents",
          "quantity"
        ],
        "additionalProperties": false
      }
    }
  },
  "required": [
    "currency",
    "tax_rate_bps",
    "items"
  ],
  "additionalProperties": false
}
