{
  "spec_version": "0.1",
  "id": "get-fare-rules",
  "version": "0.1.0",
  "description": "WebAir semantic API: price, baggage allowance, change and refund policy of one fare returned by a search.",
  "execution": "remote",
  "binding": "webair.get_fare_rules",
  "endpoint": "https://webagents-webair-production.up.railway.app/api/v1/get_fare_rules",
  "method": "POST",
  "input_schema": "schemas/api/get_fare_rules.input.schema.json",
  "output_schema": "schemas/api/get_fare_rules.output.schema.json",
  "permissions": [
    "network.webair"
  ],
  "domains": [
    "webagents-webair-production.up.railway.app"
  ],
  "timeout_seconds": 20,
  "retries": 0,
  "side_effects": "read",
  "approval_required": false,
  "extensions": {}
}
