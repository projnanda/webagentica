  "extensions": {
    "org.webagents.webair:origin": {
      "name": "WebAir",
      "fictional": true,
      "origin": "https://webagents-webair-production.up.railway.app",
      "semantic_api": "webair-semantic-api",
      "semantic_api_version": "v1",
      "note": "Informational only. Tool endpoints are upper bounds; the host chooses and the person approves every binding.",
      "host_resources": "The travel profile is read from the person's memory (a memory.read permission for the type travel.profile, memory.v0); the passenger identity and payment method are host-owned resource types (personal.read). All three are argument-free local tools; the package holds none of them and the person's host supplies the one the person grants, for the whole conversation. The simulated purchase is behind a consent step (conversation.v0): the person is asked in the turn that buys, with the quote's facts. After a quote the package may propose one travel preference (memory.write); nothing is remembered until the person accepts it."
    },
    "org.webagents:profiles-v0": {
      "profiles": [
        {
          "id": "search",
          "title": "Search flights",
          "description": "Talk to WebAir about flights and read their fare rules. Nothing personal is read or sent, so say where you fly from.",
          "permissions": [
            "network.webair",
            "model.reasoning",
            "memory.session",
            "compute.fares"
          ],
          "tools": [
            "search-flights",
            "get-fare-rules"
          ],
          "resources": [],
          "estimate": {
            "model_calls": 3,
            "tool_calls": 4,
            "tokens": 12000,
            "notes": "Per turn, from the publisher's recorded conversations of the same graph; tokens vary with the model and grow with the history. Each fare whose rules are read is one more tool call."
          }
        },
        {
          "id": "quote",
          "title": "Search and quote",
          "description": "Also fills an unstated home airport or cabin from the travel profile you choose in your memory, and sends your passenger identity to WebAir only to quote one fare you ask for. Nothing is booked.",
          "permissions": [
            "network.webair",
            "memory.travel_profile",
            "identity.passenger",
            "memory.remember",
            "model.reasoning",
            "memory.session",
            "compute.fares"
          ],
          "tools": [
            "search-flights",
            "get-fare-rules",
            "prepare-booking",
            "travel.profile",
            "personal.passenger_identity"
          ],
          "resources": [
            "personal.passenger_identity"
          ],
          "estimate": {
            "model_calls": 4,
            "tool_calls": 9,
            "tokens": 12000,
            "notes": "Per turn, from the publisher's recorded runs of the same graph, plus the one model call after a quote that proposes what to remember; tokens vary with the model and grow with the history."
          }
        },
        {
          "id": "book",
          "title": "Book (simulated)",
          "description": "Also simulates purchasing the open quote with the demo payment method you choose, after asking you in the conversation with the quote's facts. Fictional: nothing is ever charged or booked.",
          "permissions": [
            "network.webair",
            "memory.travel_profile",
            "identity.passenger",
            "wallet.payment",
            "booking.simulate_purchase",
            "memory.remember",
            "model.reasoning",
            "memory.session",
            "compute.fares"
          ],
          "tools": [
            "search-flights",
            "get-fare-rules",
            "prepare-booking",
            "simulate-purchase",
            "travel.profile",
            "personal.passenger_identity",
            "wallet.payment_method"
          ],
          "resources": [
            "personal.passenger_identity",
            "wallet.payment_method"
          ],
          "estimate": {
            "model_calls": 4,
            "tool_calls": 9,
            "tokens": 12000,
            "notes": "Per turn, from the publisher's recorded runs of the same graph, plus the one model call after a quote that proposes what to remember; tokens vary with the model and grow with the history."
          }
        }
      ]
    }
  }
}
