{
  "spec_version": "0.1",
  "package_id": "org.webagents.webair",
  "name": "WebAir Travel Agent",
  "version": "0.8.0",
  "description": "Talk to WebAir: search flights, ask about fares and rules, get a booking quote for one of them and simulate buying it, in one conversation through WebAir's own semantic API. The agent keeps the fares, the open quote and the history between turns, reads a travel profile from the person's memory and a passenger identity and a payment method the person's host owns and grants, and asks the person, with the quote's facts in front of them, before a simulated purchase. After a quote it may propose one travel preference to remember. The person's runtime checks WebAir's fare totals with a WebAssembly module that can only compute. WebAir publishes the behavior; the person's runtime supplies the authority. WebAir is a fictional demo airline: nothing is ever booked or charged.",
  "publisher": {
    "id": "webair-demo",
    "name": "WebAir (fictional demo airline)"
  },
  "created_at": "2026-10-21T00:00:00Z",
  "runtime": {
    "api": "agentpkg-runtime-v0",
    "minimum_version": "0.6.0"
  },
  "capabilities": [
    "conversation",
    "flight-search",
    "fare-rules",
    "booking-quote",
    "just-in-time-consent",
    "simulated-purchase",
    "memory-travel-profile",
    "host-passenger-identity",
    "host-payment-method",
    "memory-proposals"
  ],
  "entrypoint": "workflow.v0",
  "graph": "graph.json",
  "policy": "policy/policy.json",
