{
  "spec_version": "0.1",
  "profile": "workflow.v0",
  "coordinator": "Coordinator",
  "workers": [
    {
      "id": "Coordinator",
      "kind": "packaged",
      "skills": [],
      "tools": [],
      "max_instances": 1,
      "budget": {
        "tokens": 30000,
        "remote_calls": 4
      },
      "state_read": [
        "request",
        "plan",
        "batches",
        "perspectives",
        "agenda",
        "draft"
      ],
      "state_write": [
        "perspectives",
        "agenda"
      ]
    },
    {
      "id": "Planner",
      "kind": "packaged",
      "skills": [
        "planning"
      ],
      "tools": [],
      "max_instances": 1,
      "budget": {
        "tokens": 30000,
        "remote_calls": 4
      },
      "state_read": [
        "request"
      ],
      "state_write": [
        "plan"
      ]
    },
    {
      "id": "Perspective",
      "kind": "packaged",
      "skills": [
        "perspective"
      ],
      "tools": [],
      "max_instances": 3,
      "budget": {
        "tokens": 30000,
        "remote_calls": 4
      },
      "state_read": [
        "request",
        "plan"
      ],
      "state_write": [
        "batches"
      ]
    },
    {
      "id": "Writer",
      "kind": "packaged",
      "skills": [
        "writing"
      ],
      "tools": [],
      "max_instances": 1,
      "budget": {
        "tokens": 30000,
        "remote_calls": 4
      },
      "state_read": [
        "request",
        "plan",
        "perspectives"
      ],
      "state_write": [
        "draft"
      ]
    }
  ],
  "input_schema": "schemas/input.schema.json",
  "output_schema": "schemas/agenda.schema.json",
  "initial_state": {
    "object": {
      "request": {
        "from": "input",
        "path": ""
      },
      "plan": {
        "literal": {}
      },
      "batches": {
        "literal": []
      },
      "perspectives": {
        "literal": []
      },
      "agenda": {
        "literal": {}
      },
      "draft": {
        "literal": {}
      }
    }
  },
  "deadline_seconds": 600,
  "nodes": [
    {
      "id": "plan",
      "type": "llm",
      "worker": "Planner",
      "input": {
        "from": "state",
        "path": "/request"
      },
      "output_schema": "schemas/plan.schema.json",
      "timeout_seconds": 120,
      "depends_on": [],
      "writes": {
        "/plan": {
          "from": "result",
          "path": ""
        }
      },
      "task": "plan",
      "max_output_tokens": 12000
    },
    {
      "id": "perspectives",
      "type": "map",
      "worker": "Perspective",
      "input": {
        "from": "state",
        "path": "/request/participants"
      },
      "output_schema": "schemas/batches.schema.json",
      "timeout_seconds": 360,
      "depends_on": [
        "plan"
      ],
      "writes": {
        "/batches": {
          "from": "result",
          "path": ""
        }
      },
      "item_schema": "schemas/participant.schema.json",
      "max_items": 12,
      "max_parallel": 3,
      "steps": [
        {
          "id": "one-perspective",
          "type": "llm",
          "input": {
            "object": {
              "request": {
                "from": "state",
                "path": "/request"
              },
              "participant": {
                "from": "item",
                "path": ""
              }
            }
          },
          "output_schema": "schemas/perspectives.schema.json",
          "timeout_seconds": 300,
          "task": "perspective",
          "max_output_tokens": 12000
        }
      ],
      "yield": {
        "from": "steps",
        "path": "/one-perspective"
      }
    },
    {
      "id": "join",
      "type": "join",
      "worker": "Coordinator",
      "input": {
        "from": "state",
        "path": "/batches"
      },
      "output_schema": "schemas/perspectives.schema.json",
      "timeout_seconds": 120,
      "depends_on": [
        "perspectives"
      ],
      "writes": {
        "/perspectives": {
          "from": "result",
          "path": ""
        }
      }
    },
    {
      "id": "write",
      "type": "llm",
      "worker": "Writer",
      "input": {
        "object": {
          "request": {
            "from": "state",
            "path": "/request"
          },
          "plan": {
            "from": "state",
            "path": "/plan"
          },
          "perspectives": {
            "from": "state",
            "path": "/perspectives"
          }
        }
      },
      "output_schema": "schemas/draft.schema.json",
      "timeout_seconds": 300,
      "depends_on": [
        "join"
      ],
      "writes": {
        "/draft": {
          "from": "result",
          "path": ""
        }
      },
      "task": "write",
      "max_output_tokens": 12000
    },
    {
      "id": "assemble",
      "type": "validate",
      "worker": "Coordinator",
      "input": {
        "object": {
          "goal": {
            "from": "state",
            "path": "/request/goal"
          },
          "duration": {
            "from": "state",
            "path": "/request/duration"
          },
          "agenda": {
            "allocate": {
              "rows": {
                "from": "state",
                "path": "/draft/agenda"
              },
              "total": {
                "from": "state",
                "path": "/request/duration"
              },
              "field": "minutes"
            }
          },
          "preparation_items": {
            "from": "state",
            "path": "/draft/preparation_items"
          },
          "decisions": {
            "from": "state",
            "path": "/draft/decisions"
          },
          "questions": {
            "from": "state",
            "path": "/draft/questions"
          }
        }
      },
      "output_schema": "schemas/agenda.schema.json",
      "timeout_seconds": 120,
      "depends_on": [
        "write"
      ],
      "writes": {
        "/agenda": {
          "from": "result",
          "path": ""
        }
      }
    },
    {
      "id": "validate",
      "type": "validate",
      "worker": "Coordinator",
      "input": {
        "from": "state",
        "path": "/agenda"
      },
      "output_schema": "schemas/agenda.schema.json",
      "timeout_seconds": 120,
      "depends_on": [
        "assemble"
      ],
      "writes": {},
      "assertions": [
        {
          "kind": "equal",
          "left": {
            "from": "state",
            "path": "/agenda/goal"
          },
          "right": {
            "from": "state",
            "path": "/request/goal"
          }
        },
        {
          "kind": "equal",
          "left": {
            "from": "state",
            "path": "/agenda/duration"
          },
          "right": {
            "from": "state",
            "path": "/request/duration"
          }
        },
        {
          "kind": "sum",
          "rows": {
            "from": "state",
            "path": "/agenda/agenda"
          },
          "path": "/minutes",
          "equals": {
            "from": "state",
            "path": "/request/duration"
          }
        }
      ]
    },
    {
      "id": "output",
      "type": "output",
      "worker": "Coordinator",
      "input": {
        "from": "state",
        "path": "/agenda"
      },
      "output_schema": "schemas/agenda.schema.json",
      "timeout_seconds": 120,
      "depends_on": [
        "validate"
      ],
      "writes": {}
    }
  ],
  "fixture": "fixtures/workflow.json",
  "extensions": {},
  "exports": [
    {
      "path": "agenda.json",
      "format": "json",
      "value": {
        "from": "result",
        "path": ""
      }
    }
  ]
}
