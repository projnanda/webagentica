{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "paper_id": {
      "type": "string"
    },
    "title": {
      "type": "string"
    },
    "doi": {
      "type": [
        "string",
        "null"
      ]
    },
    "arxiv_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "authors": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "name": {
            "type": "string"
          }
        },
        "required": [
          "name"
        ],
        "additionalProperties": true
      }
    },
    "year": {
      "type": [
        "integer",
        "null"
      ]
    },
    "venue": {
      "type": [
        "string",
        "null"
      ]
    },
    "abstract": {
      "type": [
        "string",
        "null"
      ]
    },
    "url": {
      "type": [
        "string",
        "null"
      ]
    },
    "source": {
      "type": "string"
    },
    "provenance": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "source": {
            "type": "string"
          },
          "query": {
            "type": [
              "string",
              "null"
            ]
          },
          "locator": {
            "type": [
              "string",
              "null"
            ]
          },
          "synthetic": {
            "type": "boolean"
          }
        },
        "required": [
          "source"
        ],
        "additionalProperties": true
      }
    },
    "full_text_available": {
      "type": "boolean"
    },
    "screening_status": {
      "enum": [
        "include",
        "maybe",
        "exclude",
        "pending"
      ]
    },
    "screening_rationale": {
      "type": "string"
    }
  },
  "required": [
    "paper_id",
    "title",
    "doi",
    "arxiv_id",
    "authors",
    "year",
    "venue",
    "abstract",
    "url",
    "source",
    "provenance",
    "full_text_available",
    "screening_status",
    "screening_rationale"
  ],
  "additionalProperties": false
}
