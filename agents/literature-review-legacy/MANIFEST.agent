{
  "spec_version": "0.1",
  "package_id": "org.webagents.literature-review",
  "name": "Literature Review Agent",
  "version": "0.1.0",
  "description": "A constrained coordinator-worker review with structured evidence and verified citations. Bundled demo data are synthetic.",
  "publisher": {
    "id": "webagents-research",
    "name": "WebAgents Research Prototype"
  },
  "created_at": "2026-09-20T00:00:00Z",
  "runtime": {
    "api": "agentpkg-runtime-v0",
    "minimum_version": "0.1.0"
  },
  "capabilities": [
    "literature-review",
    "evidence-extraction",
    "citation-verification"
  ],
  "entrypoint": "literature.review",
  "graph": "graph.json",
  "policy": "policy/policy.json",
  "skills": [
    {
      "id": "literature-search",
      "version": "0.1.0",
