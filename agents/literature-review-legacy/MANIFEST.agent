  "model_requirements": {
    "tasks": [
      {
        "id": "plan",
        "capabilities": [
          "structured_output",
          "reasoning"
        ],
        "context_window": 16000,
        "preferred_tier": "reasoning"
      },
      {
        "id": "screen",
        "capabilities": [
          "structured_output",
          "reasoning"
        ],
        "context_window": 16000,
        "preferred_tier": "reasoning"
      },
      {
        "id": "extract",
        "capabilities": [
          "structured_output",
          "reasoning"
        ],
        "context_window": 16000,
        "preferred_tier": "reasoning"
      },
      {
        "id": "synthesize",
        "capabilities": [
          "structured_output",
          "reasoning"
        ],
        "context_window": 16000,
        "preferred_tier": "reasoning"
      },
      {
        "id": "write",
        "capabilities": [
          "structured_output",
          "reasoning"
        ],
        "context_window": 16000,
        "preferred_tier": "reasoning"
      },
      {
        "id": "verify",
        "capabilities": [
          "structured_output",
          "reasoning"
        ],
        "context_window": 16000,
        "preferred_tier": "reasoning"
      }
    ],
    "routing": "host",
    "fallback_policy": "deny",
    "extensions": {}
  },
  "evals": [
