{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentpkg.local/spec/extensions/policy-bundle-v0.schema.json",
  "title": "org.webagents:policy-bundle-v0",
  "description": "The content of a signed policy bundle a person subscribes to: trust anchors, default decisions per permission kind, budget caps, model constraints and a binding allowlist. A policy pre-decides within what a package declares and what the person's own ceiling allows; it never grants beyond either (spec/extensions/policy-bundle-v0.md). This schema checks the shape; the rules of section 4 are checked separately.",
  "type": "object",
  "properties": {
    "policy_id": {
      "$ref": "#/$defs/identifier"
    },
    "version": {
      "$ref": "#/$defs/version"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "$ref": "#/$defs/unbroken"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 480,
      "$ref": "#/$defs/unbroken"
    },
    "issuer": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "$ref": "#/$defs/unbroken"
        },
        "url": {
          "$ref": "#/$defs/https_url"
        }
      },
      "required": [
        "name"
      ],
      "additionalProperties": false
    },
    "issued_at": {
      "$ref": "#/$defs/timestamp"
    },
    "expires_at": {
      "$ref": "#/$defs/timestamp"
    },
    "trust_anchors": {
      "type": "array",
      "maxItems": 64,
      "items": {
        "$ref": "#/$defs/anchor"
      }
    },
    "decisions": {
      "type": "object",
      "properties": {
        "network": {
          "enum": [
            "deny",
            "once",
            "session"
          ]
        },
        "files.read": {
          "enum": [
            "deny",
            "once",
            "session"
          ]
        },
        "files.write": {
          "enum": [
            "deny",
            "once",
            "session"
          ]
        },
        "model": {
          "enum": [
            "deny",
            "once",
            "session"
          ]
        },
        "memory": {
          "enum": [
            "deny",
            "once",
            "session"
          ]
        },
        "shell": {
          "enum": [
            "deny",
            "once",
            "session"
          ]
        },
        "payment": {
          "enum": [
            "deny",
            "once",
            "session"
          ]
        },
        "personal.read": {
          "enum": [
            "deny",
            "once",
            "session"
          ]
        },
        "compute": {
          "enum": [
            "deny",
            "once",
            "session"
          ]
        }
      },
      "additionalProperties": false
    },
    "budget_caps": {
      "type": "object",
      "properties": {
        "total_tokens": {
          "type": "integer",
          "minimum": 1
        },
        "max_remote_calls": {
          "type": "integer",
          "minimum": 1
        },
        "max_parallel_workers": {
          "type": "integer",
          "minimum": 1
        },
        "max_output_tokens_per_call": {
          "type": "integer",
          "minimum": 1
        },
        "run_timeout_seconds": {
          "type": "integer",
          "minimum": 1
        },
        "max_calls_per_tool": {
          "type": "integer",
          "minimum": 1
        },
        "model_call_timeout_seconds": {
          "type": "integer",
          "minimum": 1
        }
      },
      "additionalProperties": false
    },
    "models": {
      "type": "object",
      "properties": {
        "local_only": {
          "type": "boolean"
        },
        "max_cost_usd_per_run": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "bindings": {
      "type": "object",
      "properties": {
        "allow": {
          "type": "array",
          "maxItems": 64,
          "items": {
            "$ref": "#/$defs/allowed_binding"
          }
        }
      },
      "required": [
        "allow"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "policy_id",
    "version",
    "title",
    "issuer",
    "issued_at",
    "expires_at",
    "trust_anchors",
    "decisions"
  ],
  "additionalProperties": false,
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$",
      "$ref": "#/$defs/unbroken"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,8})(\\.(0|[1-9][0-9]{0,8})){0,2}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "minLength": 20,
      "maxLength": 40,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "https_url": {
      "type": "string",
      "minLength": 9,
      "maxLength": 2048,
      "pattern": "^https://",
      "$ref": "#/$defs/unbroken"
    },
    "unbroken": {
      "not": {
        "pattern": "[\\u0000-\\u001F\\u007F-\\u009F\\u2028\\u2029]"
      }
    },
    "raw_key": {
      "type": "string",
      "pattern": "^[A-Za-z0-9+/]{43}=$"
    },
    "fingerprint": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "anchor": {
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "publisher_key"
            },
            "public_key": {
              "$ref": "#/$defs/raw_key"
            },
            "fingerprint": {
              "$ref": "#/$defs/fingerprint"
            },
            "display_name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120,
              "$ref": "#/$defs/unbroken"
            },
            "publisher_id": {
              "$ref": "#/$defs/identifier"
            },
            "package_id_prefix": {
              "$ref": "#/$defs/identifier"
            }
          },
          "required": [
            "kind",
            "public_key",
            "fingerprint",
            "display_name",
            "publisher_id",
            "package_id_prefix"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "kind": {
              "const": "issuer"
            },
            "public_key": {
              "$ref": "#/$defs/raw_key"
            },
            "fingerprint": {
              "$ref": "#/$defs/fingerprint"
            },
            "display_name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120,
              "$ref": "#/$defs/unbroken"
            },
            "scope": {
              "type": "object",
              "properties": {
                "package_id_prefix": {
                  "$ref": "#/$defs/identifier"
                },
                "publisher_id": {
                  "$ref": "#/$defs/identifier"
                }
              },
              "required": [
                "package_id_prefix"
              ],
              "additionalProperties": false
            }
          },
          "required": [
            "kind",
            "public_key",
            "fingerprint",
            "display_name",
            "scope"
          ],
          "additionalProperties": false
        }
      ]
    },
    "allowed_binding": {
      "type": "object",
      "properties": {
        "kind": {
          "enum": [
            "json_http",
            "local_builtin",
            "selected_file",
            "host_resource"
          ]
        },
        "origins": {
          "type": "array",
          "minItems": 1,
          "maxItems": 64,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 300,
            "pattern": "^https://[a-z0-9]([a-z0-9-]{0,62}[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]{0,62}[a-z0-9])?)+$"
          }
        }
      },
      "required": [
        "kind"
      ],
      "additionalProperties": false
    }
  }
}
