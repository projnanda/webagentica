{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentpkg.local/spec/extensions/profiles-v0.schema.json",
  "title": "org.webagents:profiles-v0",
  "description": "The value of the noncritical manifest extension `org.webagents:profiles-v0`: publisher-declared profiles that group permissions, tools and host resource types the package already declares. A profile presents authority and never grants it. This schema checks the shape only; the consistency rules against the package (spec/extensions/profiles-v0.md, section 4) are checked separately.",
  "type": "object",
  "properties": {
    "profiles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 8,
      "items": {
        "$ref": "#/$defs/profile"
      }
    }
  },
  "required": [
    "profiles"
  ],
  "additionalProperties": false,
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$",
      "$ref": "#/$defs/unbroken"
    },
    "identifiers": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/identifier"
      },
      "uniqueItems": true,
      "maxItems": 512
    },
    "line": {
      "type": "string",
      "minLength": 1,
      "$ref": "#/$defs/unbroken"
    },
    "unbroken": {
      "$comment": "No control character (C0, DEL, C1) and no line or paragraph separator anywhere. An unanchored search behaves the same in every regex engine; an anchored `^...$` does not, because Python's `$` also matches before a trailing newline.",
      "not": {
        "pattern": "[\\u0000-\\u001F\\u007F-\\u009F\\u2028\\u2029]"
      }
    },
    "profile": {
      "type": "object",
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "title": {
          "$ref": "#/$defs/line",
          "maxLength": 60
        },
        "description": {
          "$ref": "#/$defs/line",
          "maxLength": 240
        },
        "permissions": {
          "$ref": "#/$defs/identifiers"
        },
        "tools": {
          "$ref": "#/$defs/identifiers"
        },
        "resources": {
          "$ref": "#/$defs/identifiers"
        },
        "estimate": {
          "$ref": "#/$defs/estimate"
        }
      },
      "required": [
        "id",
        "title",
        "description",
        "permissions",
        "tools",
        "resources"
      ],
      "additionalProperties": false
    },
    "estimate": {
      "type": "object",
      "properties": {
        "model_calls": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "tool_calls": {
          "type": "integer",
          "minimum": 0,
          "maximum": 100000
        },
        "tokens": {
          "type": "integer",
          "minimum": 0,
          "maximum": 1000000000
        },
        "notes": {
          "$ref": "#/$defs/line",
          "maxLength": 240
        }
      },
      "minProperties": 1,
      "additionalProperties": false
    }
  }
}
