{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentpkg.local/spec/extensions/agent-index-v0.schema.json",
  "title": "org.webagents:agent-index-v0",
  "description": "The content of a signed agent index: a publisher's list of agent packages with where to fetch them. Every field is metadata, never authority: opening an entry is the ordinary download, verification, trust and authorization of the package at package_url (spec/extensions/agent-index-v0.md). This schema checks the shape; the rules of section 4 are checked separately.",
  "type": "object",
  "properties": {
    "index_id": {
      "$ref": "#/$defs/identifier"
    },
    "version": {
      "$ref": "#/$defs/version"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 80,
      "$ref": "#/$defs/unbroken"
    },
    "description": {
      "type": "string",
      "minLength": 1,
      "maxLength": 480,
      "$ref": "#/$defs/unbroken"
    },
    "publisher": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "$ref": "#/$defs/unbroken"
        },
        "url": {
          "$ref": "#/$defs/https_url"
        }
      },
      "required": [
        "name"
      ],
      "additionalProperties": false
    },
    "issued_at": {
      "$ref": "#/$defs/timestamp"
    },
    "expires_at": {
      "$ref": "#/$defs/timestamp"
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "maxItems": 256,
      "items": {
        "$ref": "#/$defs/entry"
      }
    }
  },
  "required": [
    "index_id",
    "version",
    "title",
    "publisher",
    "issued_at",
    "expires_at",
    "entries"
  ],
  "additionalProperties": false,
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$",
      "$ref": "#/$defs/unbroken"
    },
    "version": {
      "type": "string",
      "pattern": "^(0|[1-9][0-9]{0,8})(\\.(0|[1-9][0-9]{0,8})){0,2}$"
    },
    "timestamp": {
      "type": "string",
      "format": "date-time",
      "minLength": 20,
      "maxLength": 40,
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,9})?(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "https_url": {
      "type": "string",
      "minLength": 9,
      "maxLength": 2048,
      "pattern": "^https://",
      "$ref": "#/$defs/unbroken"
    },
    "unbroken": {
      "not": {
        "pattern": "[\\u0000-\\u001F\\u007F-\\u009F\\u2028\\u2029]"
      }
    },
    "entry": {
      "type": "object",
      "properties": {
        "package_id": {
          "$ref": "#/$defs/identifier"
        },
        "name": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "$ref": "#/$defs/unbroken"
        },
        "version": {
          "type": "string",
          "minLength": 1,
          "maxLength": 64,
          "pattern": "^[0-9A-Za-z.+-]+$"
        },
        "description": {
          "type": "string",
          "minLength": 1,
          "maxLength": 480,
          "$ref": "#/$defs/unbroken"
        },
        "publisher": {
          "type": "object",
          "properties": {
            "id": {
              "$ref": "#/$defs/identifier"
            },
            "name": {
              "type": "string",
              "minLength": 1,
              "maxLength": 120,
              "$ref": "#/$defs/unbroken"
            }
          },
          "required": [
            "id",
            "name"
          ],
          "additionalProperties": false
        },
        "package_url": {
          "$ref": "#/$defs/https_url"
        },
        "digest": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "archive_sha256": {
          "type": "string",
          "pattern": "^[0-9a-f]{64}$"
        },
        "signer_fingerprint": {
          "type": "string",
          "pattern": "^sha256:[0-9a-f]{64}$"
        },
        "locators": {
          "type": "array",
          "maxItems": 8,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "maxLength": 254,
            "pattern": "^[a-z0-9][a-z0-9._-]{0,63}@[a-z0-9]([a-z0-9-]{0,62}[a-z0-9])?(\\.[a-z0-9]([a-z0-9-]{0,62}[a-z0-9])?)+$"
          }
        },
        "tags": {
          "type": "array",
          "maxItems": 16,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z0-9][a-z0-9-]{0,31}$"
          }
        },
        "homepage": {
          "$ref": "#/$defs/https_url"
        }
      },
      "required": [
        "package_id",
        "name",
        "version",
        "description",
        "publisher",
        "package_url"
      ],
      "additionalProperties": false
    }
  }
}
