{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentpkg.local/spec/0.1/signature.schema.json",
  "type": "object",
  "properties": {
    "format": {
      "const": "agent.pkg-signature-v0.1"
    },
    "algorithm": {
      "const": "Ed25519"
    },
    "key_fingerprint": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$"
    },
    "public_key": {
      "type": "string",
      "pattern": "^[A-Za-z0-9+/]{43}=$"
    },
    "signature": {
      "type": "string",
      "pattern": "^[A-Za-z0-9+/]{86}==$"
    },
    "digest": {
      "type": "string",
      "pattern": "^[0-9a-f]{64}$"
    }
  },
  "required": [
    "format",
    "algorithm",
    "key_fingerprint",
    "public_key",
    "signature",
    "digest"
  ],
  "additionalProperties": false
}
