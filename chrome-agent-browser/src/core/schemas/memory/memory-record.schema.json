{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentpkg.local/spec/memory-v0/memory-record.schema.json",
  "title": "memory.v0 record (parsed: frontmatter fields under `fields`, the body under `body`)",
  "type": "object",
  "properties": {
    "id": {
      "type": "string",
      "pattern": "^(self|mem_[0-9a-f]{32}|agent_[0-9a-f]{16})$"
    },
    "type": {
      "$ref": "#/$defs/type_id"
    },
    "title": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^[^\\u0000-\\u001f\\u007f]+$"
    },
    "scope": {
      "enum": [
        "user",
        "agent"
      ]
    },
    "created": {
      "$ref": "#/$defs/timestamp"
    },
    "updated": {
      "$ref": "#/$defs/timestamp"
    },
    "valid_until": {
      "$ref": "#/$defs/date"
    },
    "source": {
      "$ref": "#/$defs/source"
    },
    "fields": {
      "type": "object"
    },
    "sealed": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/pointer"
      },
      "maxItems": 16,
      "uniqueItems": true
    },
    "links": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/link"
      },
      "maxItems": 64,
      "uniqueItems": true
    },
    "tags": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/tag"
      },
      "maxItems": 32,
      "uniqueItems": true
    },
    "demo": {
      "type": "boolean"
    },
    "body": {
      "type": "string",
      "maxLength": 32768
    }
  },
  "required": [
    "id",
    "type",
    "title",
    "scope",
    "created",
    "updated",
    "source",
    "fields",
    "body"
  ],
  "additionalProperties": false,
  "allOf": [
    {
      "if": {
        "properties": {
          "scope": {
            "const": "agent"
          }
        }
      },
      "then": {
        "properties": {
          "type": {
            "const": "agent.memory"
          },
          "id": {
            "pattern": "^agent_[0-9a-f]{16}$"
          },
          "source": {
            "properties": {
              "kind": {
                "const": "agent"
              }
            }
          },
          "body": {
            "maxLength": 32768
          }
        },
        "not": {
          "anyOf": [
            {
              "required": [
                "links"
              ],
              "properties": {
                "links": {
                  "minItems": 1
                }
              }
            },
            {
              "required": [
                "tags"
              ],
              "properties": {
                "tags": {
                  "minItems": 1
                }
              }
            }
          ]
        }
      },
      "else": {
        "properties": {
          "type": {
            "not": {
              "const": "agent.memory"
            }
          },
          "id": {
            "pattern": "^(self|mem_[0-9a-f]{32})$"
          },
          "body": {
            "maxLength": 16384
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "id": {
            "const": "self"
          }
        }
      },
      "then": {
        "properties": {
          "type": {
            "const": "person.self"
          },
          "scope": {
            "const": "user"
          }
        },
        "not": {
          "required": [
            "sealed"
          ]
        }
      },
      "else": {
        "properties": {
          "type": {
            "not": {
              "const": "person.self"
            }
          }
        }
      }
    }
  ],
  "$defs": {
    "type_id": {
      "type": "string",
      "maxLength": 200,
      "pattern": "^([a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*|[A-Za-z][A-Za-z0-9_.:-]{0,127}:[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)*)$"
    },
    "timestamp": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,3})?Z$"
    },
    "date": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "pointer": {
      "type": "string",
      "minLength": 2,
      "maxLength": 256,
      "pattern": "^(/[^/]+)+$"
    },
    "tag": {
      "type": "string",
      "pattern": "^[a-z0-9][a-z0-9_/-]{0,47}$"
    },
    "identifier": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"
    },
    "relation": {
      "enum": [
        "about",
        "prefers",
        "pays_with",
        "belongs_to",
        "supersedes",
        "derived_from",
        "related"
      ]
    },
    "link": {
      "type": "object",
      "properties": {
        "to": {
          "type": "string",
          "pattern": "^(self|mem_[0-9a-f]{32})$"
        },
        "rel": {
          "$ref": "#/$defs/relation"
        }
      },
      "required": [
        "to",
        "rel"
      ],
      "additionalProperties": false
    },
    "source": {
      "type": "object",
      "oneOf": [
        {
          "properties": {
            "kind": {
              "const": "person"
            }
          },
          "required": [
            "kind"
          ],
          "additionalProperties": false
        },
        {
          "properties": {
            "kind": {
              "const": "package"
            },
            "package_id": {
              "$ref": "#/$defs/identifier"
            },
            "package_version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "run_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            },
            "proposal": {
              "type": "integer",
              "minimum": 0,
              "maximum": 7
            },
            "accepted": {
              "$ref": "#/$defs/timestamp"
            }
          },
          "required": [
            "kind",
            "package_id",
            "package_version",
            "run_id",
            "proposal",
            "accepted"
          ],
          "additionalProperties": false
        },
        {
          "properties": {
            "kind": {
              "const": "agent"
            },
            "package_id": {
              "$ref": "#/$defs/identifier"
            },
            "package_version": {
              "type": "string",
              "minLength": 1,
              "maxLength": 64
            },
            "run_id": {
              "type": "string",
              "minLength": 1,
              "maxLength": 128
            }
          },
          "required": [
            "kind",
            "package_id",
            "package_version",
            "run_id"
          ],
          "additionalProperties": false
        },
        {
          "properties": {
            "kind": {
              "const": "import"
            },
            "from": {
              "type": "string",
              "minLength": 1,
              "maxLength": 255
            },
            "imported": {
              "$ref": "#/$defs/timestamp"
            }
          },
          "required": [
            "kind",
            "from",
            "imported"
          ],
          "additionalProperties": false
        },
        {
          "properties": {
            "kind": {
              "const": "migration"
            },
            "from_type": {
              "$ref": "#/$defs/identifier"
            },
            "migrated": {
              "$ref": "#/$defs/timestamp"
            }
          },
          "required": [
            "kind",
            "from_type",
            "migrated"
          ],
          "additionalProperties": false
        }
      ]
    }
  }
}
