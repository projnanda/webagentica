{
  "name": "chrome-agent-browser",
  "version": "0.6.0",
  "description": "Chrome Agent Browser: a portable TypeScript core that opens, verifies, authorizes and executes signed agent.pkg packages (workflow.v0), a Node CLI with agentpkg's shape, and a Manifest V3 extension that discovers packages on websites, authorizes them and runs them with the person's own models.",
  "license": "Apache-2.0",
  "type": "module",
  "private": true,
  "engines": {
    "node": ">=24.16"
  },
  "scripts": {
    "typecheck": "tsc -p tsconfig.core.json --noEmit && tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "build": "node scripts/build.mjs",
    "pack": "node scripts/pack.mjs",
    "check-pack": "node scripts/check-pack.mjs",
    "sync-schemas": "node scripts/sync-schemas.mjs",
    "e2e": "node scripts/e2e-discovery.mjs"
  },
  "dependencies": {
    "@hyperjump/browser": "^1.5.1",
    "@hyperjump/json-schema": "^1.18.0",
    "@noble/ed25519": "^3.2.0",
    "@noble/hashes": "2.4.0",
    "@wllama/wllama": "3.8.1",
    "pdfjs-dist": "6.3.289"
  },
  "devDependencies": {
    "@types/chrome": "^0.3.4",
    "@types/node": "^24.0.0",
    "esbuild": "0.28.2",
    "fake-indexeddb": "^6.2.5",
    "happy-dom": "^20.0.0",
    "typescript": "^5.9.0",
    "vitest": "^5.0.1"
  }
}
