{
  "spec_version": "0.1",
  "permissions": [
    {
      "id": "network.scholarly",
      "kind": "network",
      "description": "Search Crossref.",
      "required": true,
      "resources": [
        "api.crossref.org"
      ]
    },
    {
      "id": "network.citations",
      "kind": "network",
      "description": "Resolve identifiers at the Citation Resolver, or at Crossref when it is unavailable.",
      "required": true,
      "resources": [
        "webagents-citation-resolver-production.up.railway.app",
        "api.crossref.org"
      ]
    },
    {
      "id": "model.reasoning",
      "kind": "model",
      "description": "Declared so a run plan can bind a model; this graph calls none.",
      "required": false,
      "resources": [
        "host-router"
      ]
    },
    {
      "id": "memory.session",
      "kind": "memory",
      "description": "Session state only.",
      "required": true,
      "resources": [
        "session"
      ]
    }
  ],
  "network": {
    "allowed_domains": [
      "api.crossref.org",
      "webagents-citation-resolver-production.up.railway.app"
    ],
    "https_only": true,
    "allow_redirects": false
  },
  "memory": {
    "scope": "session",
    "retention": "session",
    "raw_documents": false,
    "state_schema": "schemas/state.schema.json",
    "sharing": "explicit_views"
  },
  "budget": {
    "estimated_tokens": 10,
    "hard_tokens": 1000,
    "max_remote_calls": 24,
    "max_calls_per_tool": {
      "citation-resolver": 4,
      "scholarly-search": 1
    },
    "max_parallel_workers": 1,
    "estimated_cost_usd": null,
    "approval_threshold_tokens": null
  },
  "delegation": {
    "max_depth": 1,
    "approved_roles": [
      "CitationWorker",
      "SearchWorker"
    ],
    "allow_remote": false
  },
  "extensions": {}
}
