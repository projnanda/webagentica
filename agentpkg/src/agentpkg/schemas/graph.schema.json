{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agentpkg.local/spec/0.1/graph.schema.json",
  "type": "object",
  "properties": {
    "spec_version": {
      "const": "0.1"
    },
    "coordinator": {
      "type": "string",
      "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"
    },
    "workers": {
      "type": "array",
      "minItems": 1,
      "maxItems": 64,
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"
          },
          "kind": {
            "enum": [
              "packaged",
              "remote",
              "nanda"
            ]
          },
          "skills": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"
            },
            "maxItems": 512,
            "uniqueItems": true
          },
          "tools": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"
            },
            "maxItems": 512,
            "uniqueItems": true
          },
          "max_instances": {
            "type": "integer",
            "minimum": 1,
            "maximum": 64
          },
          "budget": {
            "type": "object",
            "properties": {
              "tokens": {
                "type": "integer",
                "minimum": 0,
                "maximum": 2147483647
              },
              "remote_calls": {
                "type": "integer",
                "minimum": 0,
                "maximum": 2147483647
              }
            },
            "required": [
              "tokens",
              "remote_calls"
            ],
            "additionalProperties": false
          },
          "state_read": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"
            },
            "maxItems": 512,
            "uniqueItems": true
          },
          "state_write": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"
            },
            "maxItems": 512,
            "uniqueItems": true
          },
          "locator": {
            "type": "string",
            "pattern": "^(https://|nanda:).+",
            "maxLength": 2048
          }
        },
        "required": [
          "id",
          "kind",
          "skills",
          "tools",
          "max_instances",
          "budget",
          "state_read",
          "state_write"
        ],
        "additionalProperties": false,
        "allOf": [
          {
            "if": {
              "properties": {
                "kind": {
                  "const": "packaged"
                }
              }
            },
            "then": {
              "not": {
                "required": [
                  "locator"
                ]
              }
            },
            "else": {
              "required": [
                "locator"
              ]
            }
          }
        ]
      }
    },
    "stages": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"
          },
          "worker": {
            "type": "string",
            "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"
          },
          "depends_on": {
            "type": "array",
            "items": {
              "type": "string",
              "pattern": "^[A-Za-z][A-Za-z0-9_.:-]{0,127}$"
            },
            "maxItems": 512,
            "uniqueItems": true
          },
          "parallel": {
            "type": "boolean"
          },
          "merge": {
            "enum": [
              "append",
              "replace",
              "deduplicate"
            ]
          },
          "extensions": {
            "type": "object",
            "propertyNames": {
              "pattern": "^[a-z][a-z0-9.-]*:[A-Za-z][A-Za-z0-9_.-]*$"
            },
            "additionalProperties": true
          }
        },
        "required": [
          "id",
          "worker",
          "depends_on",
          "parallel",
          "merge",
          "extensions"
        ],
        "additionalProperties": false
      },
      "maxItems": 512
    },
    "extensions": {
      "type": "object",
      "propertyNames": {
        "pattern": "^[a-z][a-z0-9.-]*:[A-Za-z][A-Za-z0-9_.-]*$"
      },
      "additionalProperties": true
    }
  },
  "required": [
    "spec_version",
    "coordinator",
    "workers",
    "stages",
    "extensions"
  ],
  "additionalProperties": false
}
