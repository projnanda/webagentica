{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "body": {
      "type": "string",
      "maxLength": 32768
    },
    "updated": {
      "anyOf": [
        {
          "type": "string",
          "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]{1,3})?Z$"
        },
        {
          "type": "null"
        }
      ]
    }
  },
  "required": [
    "body",
    "updated"
  ],
  "additionalProperties": false
}
